{
  "name": "triangle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "substrat": {
    "permissions": "src/provision.ts",
    "runtimeNeeds": {
      "entry": "src/worker.ts",
      "stores": [
        {
          "binding": "SCOPE",
          "class": "ScopeDO"
        },
        {
          "binding": "SWEEPER",
          "class": "SweeperDO"
        }
      ],
      "build": "npm --prefix app install && npm --prefix app run build",
      "assets": {
        "directory": "app/dist",
        "notFoundHandling": "single-page-application",
        "runWorkerFirst": [
          "/api/*",
          "/internal/*"
        ]
      }
    },
    "tenant": "t-5ra4yxscep",
    "slug": "triangle"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"npm --prefix app run dev\"",
    "server": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint:boundaries": "substrat-boundary-lint",
    "app:build": "npm --prefix app run build",
    "changeset": "changeset",
    "release": "pnpm test && pnpm typecheck && pnpm lint:boundaries && changeset version && substrat push --promote prod"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@substrat-run/adapter-cloudflare": "^0.55.0",
    "@substrat-run/adapter-sqlite": "^0.55.0",
    "@substrat-run/contracts": "^0.55.0",
    "@substrat-run/kernel": "^0.55.0",
    "@substrat-run/vertical-host": "^0.55.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@substrat-run/boundary-lint": "^0.0.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}